{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fairflow-water/fairflow/scenario.schema.json",
  "title": "Fairflow scenario (blueprint §6.1, schemaVersion 3.0)",
  "description": "Structure only. Numeric model parameters not given here come from packages/scenarios/parameters.json; hard checks (§5.2) and derived-value agreement are applied by the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "provenance", "basin", "schemes", "lenses", "defaultLens", "modules"],
  "properties": {
    "$comment": { "type": "string" },
    "schemaVersion": { "const": "3.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "sources": { "type": "object", "additionalProperties": { "$ref": "#/$defs/source" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "createdBy", "createdAt"],
      "properties": {
        "kind": { "enum": ["example", "builder", "pipeline", "pilot"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "basedOn": { "type": ["string", "null"] }
      }
    },
    "basin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inflow", "deck", "reserve", "aquifer", "gameLength"],
      "properties": {
        "inflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wet", "normal", "dry", "unit", "source"],
          "properties": {
            "wet": { "$ref": "#/$defs/positive" },
            "normal": { "$ref": "#/$defs/positive" },
            "dry": { "$ref": "#/$defs/positive" },
            "unit": { "const": "Mm3/season" },
            "dryDrift": { "$ref": "#/$defs/nonNegative" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "deck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wet", "normal", "dry"],
          "properties": {
            "wet": { "type": "integer", "minimum": 0 },
            "normal": { "type": "integer", "minimum": 0 },
            "dry": { "type": "integer", "minimum": 0 }
          }
        },
        "reserve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "mode", "source"],
          "properties": {
            "value": { "$ref": "#/$defs/nonNegative" },
            "mode": { "enum": ["absolute", "fraction"] },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "orchardCrop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depthMm", "beta", "yieldTHa", "ky", "price", "source"],
          "$comment": "ADR 0007: the crop a scheme takes on when it plays Orchard",
          "properties": {
            "crop": { "type": "string" },
            "depthMm": { "$ref": "#/$defs/positive" },
            "beta": { "$ref": "#/$defs/fraction", "$comment": "consumed fraction of the method depthMm is given for" },
            "yieldTHa": { "$ref": "#/$defs/positive" },
            "ky": { "type": "number", "minimum": 0, "maximum": 2 },
            "price": { "$ref": "#/$defs/nonNegative" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "aquifer": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "returnRecharge: share of non-consumed water that recharges the shared aquifer (ADR 0007)",
          "required": ["initial", "reserve", "lowThreshold", "naturalRecharge", "gwSwCoupling", "source"],
          "properties": {
            "initial": { "$ref": "#/$defs/positive" },
            "reserve": { "$ref": "#/$defs/nonNegative" },
            "lowThreshold": { "$ref": "#/$defs/positive" },
            "naturalRecharge": { "$ref": "#/$defs/nonNegative" },
            "surplusRecharge": { "type": "boolean" },
            "returnFlows": { "type": "boolean" },
            "returnRecharge": { "$ref": "#/$defs/fraction" },
            "gwSwCoupling": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "maxInflowLossMm3"],
              "$comment": "lossPerMm3BelowFull (ADR 0008): baseflow lost per Mm³ of storage below B₀; when present it replaces the maxInflowLossMm3 rule",
              "properties": {
                "enabled": { "type": "boolean" },
                "maxInflowLossMm3": { "$ref": "#/$defs/nonNegative" },
                "lossPerMm3BelowFull": { "$ref": "#/$defs/nonNegative" }
              }
            },
            "seatCostMultipliers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/positive" } },
            "tankResolution": { "$ref": "#/$defs/positive" },
            "capacity": { "$ref": "#/$defs/positive" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "gameLength": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "schemes": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/scheme" } },
    "lenses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lens" } },
    "defaultLens": { "$ref": "#/$defs/lensId" },
    "floorRules": { "type": "array", "items": { "enum": ["proportional", "cea", "cel", "talmud", "capability"] }, "uniqueItems": true },
    "actions": {
      "type": "object",
      "properties": {
        "pump": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "ADR 0008: capShare = well capacity as a share of each scheme's demand; costSlope may be derived from the head (see the scenario's source)",
          "properties": {
            "cap": { "$ref": "#/$defs/positive" },
            "capShare": { "$ref": "#/$defs/fraction" },
            "costBase": { "$ref": "#/$defs/nonNegative" },
            "costSlope": { "$ref": "#/$defs/nonNegative" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M2", "M3", "M4", "M5", "M6"],
      "properties": {
        "M2": { "type": "boolean" }, "M3": { "type": "boolean" }, "M4": { "type": "boolean" },
        "M5": { "type": "boolean" }, "M6": { "type": "boolean" }
      }
    },
    "moduleParams": { "type": "object" },
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "review E7: values that divide by zero or take the log of zero are refused",
      "properties": {
        "survivalFloor": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "welfareSupplyFloor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "welfareGamma": { "$ref": "#/$defs/nonNegative" },
        "r3Ramp": { "$ref": "#/$defs/positive" },
        "sustainabilityBands": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "session": { "type": "object" },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["schematic", "geojson"] }, "geojson": {}, "unitAttributes": {} }
    },
    "treatments": { "type": "object" }
  },
  "$defs": {
    "source": { "type": "string", "minLength": 1 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "nonNegative": { "type": "number", "minimum": 0 },
    "fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "lensId": {
      "enum": ["utilitarian", "weighted_utilitarian", "egalitarian", "proportional", "capability", "sufficientarian",
               "prioritarian", "equal_sacrifice", "talmud"]
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/lensId" },
        "enabled": { "type": "boolean" },
        "plainName": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gamma": { "type": "number", "minimum": 1 },
            "weight": { "enum": ["1", "people"] },
            "floor": { "$ref": "#/$defs/fraction" },
            "secondary": { "enum": ["max_value", "prioritarian", "proportional"] }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "entered", "outOfRange"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "entered": { "enum": ["example", "user", "assumed", "derived"] },
        "outOfRange": { "type": "boolean" }
      }
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "seat", "areaHa", "depthMm", "beta", "yieldTHa", "ky", "people", "peopleUnit", "kappa", "price", "derived"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "seat": { "type": "integer", "minimum": 1 },
        "shape": { "type": "string" },
        "glyph": { "type": "string" },
        "crop": { "type": "string" },
        "method": { "type": "string" },
        "actions": { "type": "array", "items": { "enum": ["orchard", "drip", "expand"] }, "uniqueItems": true, "$comment": "actions this scheme may play; omitted = all" },
        "pumpCostFactor": { "$ref": "#/$defs/positive", "$comment": "ADR 0008: pumping energy per m³ relative to the most efficient pump set, η_ref/η_i" },
        "wellsFailAtOrBelow": { "$ref": "#/$defs/nonNegative", "$comment": "ADR 0008: observed aquifer stock at or below which this scheme's shallow wells stop delivering" },
        "areaHa": { "$ref": "#/$defs/positive" },
        "depthMm": { "$ref": "#/$defs/positive" },
        "beta": { "$ref": "#/$defs/fraction" },
        "yieldTHa": { "$ref": "#/$defs/positive" },
        "ky": { "type": "number", "minimum": 0, "maximum": 2, "$comment": "review E7: at the 0.5 survival floor FAO-33 gives Y = K(1 − 0.5 Ky), negative for Ky > 2" },
        "people": { "$ref": "#/$defs/positive" },
        "peopleUnit": { "enum": ["employees", "households", "dependants", "people"] },
        "kappa": { "$ref": "#/$defs/positive", "$comment": "review E4: a zero weight empties the capability lens's weight sum" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": ["demandMm3", "capacityT", "wpKgM3"],
          "properties": {
            "demandMm3": { "$ref": "#/$defs/positive" },
            "capacityT": { "$ref": "#/$defs/positive" },
            "wpKgM3": { "$ref": "#/$defs/positive" }
          }
        },
        "privateGoal": { "type": "object" },
        "card": { "type": "object" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } }
      }
    }
  }
}
