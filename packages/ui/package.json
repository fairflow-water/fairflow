{
  "name": "@fairflow/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Fairflow client (blueprint §5, §7.1): room join, climate and lens vote screens; every number comes from the engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
